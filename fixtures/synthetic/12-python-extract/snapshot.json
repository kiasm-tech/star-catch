      "headContent": "class Cart:\n    def __init__(self, items):\n        self.items = items\n\n    def total(self):\n        subtotal = self._subtotal()\n        if subtotal > 100:\n            subtotal *= 0.95\n        return round(subtotal, 2)\n\n    def _subtotal(self):\n        return sum(item.price * item.qty for item in self.items)\n"
