      "patch": "@@ -1,13 +1,13 @@\n VAT_RATE = 0.21\n \n \n-def _gross(amount):\n+def _with_vat(amount):\n     return round(amount * (1 + VAT_RATE), 2)\n \n \n def line_total(qty, unit_price):\n-    return _gross(qty * unit_price)\n+    return _with_vat(qty * unit_price)\n \n \n def invoice_total(lines):\n-    return sum(_gross(qty * price) for qty, price in lines)\n+    return sum(_with_vat(qty * price) for qty, price in lines)",
      "baseContent": "VAT_RATE = 0.21\n\n\ndef _gross(amount):\n    return round(amount * (1 + VAT_RATE), 2)\n\n\ndef line_total(qty, unit_price):\n    return _gross(qty * unit_price)\n\n\ndef invoice_total(lines):\n    return sum(_gross(qty * price) for qty, price in lines)\n",
      "headContent": "VAT_RATE = 0.21\n\n\ndef _with_vat(amount):\n    return round(amount * (1 + VAT_RATE), 2)\n\n\ndef line_total(qty, unit_price):\n    return _with_vat(qty * unit_price)\n\n\ndef invoice_total(lines):\n    return sum(_with_vat(qty * price) for qty, price in lines)\n"
    }
