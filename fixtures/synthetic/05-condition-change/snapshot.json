      "baseContent": "export const BULK_DISCOUNT_RATE = 0.1;\n\nexport function bulkDiscount(quantity: number, unitPrice: number): number {\n  if (quantity >= 10) {\n    return quantity * unitPrice * BULK_DISCOUNT_RATE;\n  }\n  return 0;\n}\n",
      "headContent": "export const BULK_DISCOUNT_RATE = 0.1;\n\nexport function bulkDiscount(quantity: number, unitPrice: number): number {\n  if (quantity >= 5) {\n    return quantity * unitPrice * BULK_DISCOUNT_RATE;\n  }\n  return 0;\n}\n"
