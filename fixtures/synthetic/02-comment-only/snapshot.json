      "headContent": "export function shippingCost(weightKg: number): number {\n  // Parcels up to 2 kg pay the flat rate of 4.99 EUR (in cents)\n  if (weightKg <= 2) return 499;\n  // Every started kilogram above that adds 1.50 EUR\n  return 499 + Math.ceil(weightKg - 2) * 150;\n}\n"
